{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information and subscription status",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isPro": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "isPro", "createdAt"]
    },
    "Translation": {
      "title": "Translation",
      "description": "Record of a translation or official draft generation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "pdf", "gov"] },
        "sourceText": { "type": "string" },
        "resultText": { "type": "string" },
        "sourceLang": { "type": "string" },
        "targetLang": { "type": "string" },
        "fileName": { "type": "string" },
        "fileType": { "type": "string" },
        "govMode": { "type": "string", "enum": ["reply", "noting"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "createdAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback on translations or feature suggestions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "translationId": { "type": "string" },
        "rating": { "type": "number", "description": "1 to 5 stars" },
        "comment": { "type": "string" },
        "type": { "type": "string", "enum": ["accuracy", "suggestion"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/translations/{translationId}": {
      "schema": "Translation",
      "description": "Translation history"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback"
    }
  }
}
