rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2 & 5: Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'isPro', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.email is string && data.email.size() <= 256 &&
             data.email == request.auth.token.email && // Identity Integrity
             data.isPro is bool &&
             data.createdAt == request.time &&
             (data.get('displayName', '') is string && data.displayName.size() <= 200) &&
             (data.get('photoURL', '') is string && data.photoURL.size() <= 1000);
    }

    function isValidTranslation(data) {
      return data.keys().hasAll(['userId', 'type', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.userId == request.auth.uid &&
             data.type in ['text', 'image', 'pdf', 'gov'] &&
             data.createdAt == request.time &&
             (data.get('sourceText', '') is string && data.sourceText.size() <= 100000) &&
             (data.get('resultText', '') is string && data.resultText.size() <= 100000) &&
             (data.get('sourceLang', '') is string && data.sourceLang.size() <= 50) &&
             (data.get('targetLang', '') is string && data.targetLang.size() <= 50) &&
             (data.get('fileName', '') is string && data.fileName.size() <= 512) &&
             (data.get('fileType', '') is string && data.fileType.size() <= 128) &&
             (data.get('govMode', '') in ['reply', 'noting', null]);
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['rating', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time &&
             (data.get('userId', null) == (isSignedIn() ? request.auth.uid : null)) &&
             (!data.keys().hasAll(['comment']) || data.comment == null || (data.comment is string && data.comment.size() <= 2000)) &&
             (!data.keys().hasAll(['type']) || data.type == null || (data.type in ['accuracy', 'suggestion'])) &&
             (!data.keys().hasAll(['translationId']) || data.translationId == null || (data.translationId is string && data.translationId.size() <= 128));
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().isPro == false;
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().email == existing().email &&
                      incoming().createdAt == existing().createdAt &&
                      // Users cannot self-assign Pro status
                      (incoming().isPro == existing().isPro || incoming().isPro == false);
    }

    // 2. Translations Collection
    match /translations/{translationId} {
      // Pillar 8: Secure List Queries
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidTranslation(incoming());
      
      // Translations are mostly immutable records, but allow delete by owner
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 3. Feedback Collection
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(incoming()); // Allow anonymous or signed-in feedback
      allow read: if false; // Only admins or processed elsewhere (internal)
    }
  }
}
